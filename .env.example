KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081
KAFKA_CONSUMER_GROUP_PREFIX=scvri
KAFKA_DEFAULT_TOPIC_PARTITIONS=6
KAFKA_DEFAULT_TOPIC_REPLICAS=1
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=certs/jwt_private.pem
JWT_PUBLIC_KEY_PATH=certs/jwt_public.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ISSUER=http://localhost:8000
JWT_AUDIENCE=http://localhost
IAM_JWKS_URI=http://localhost:8000/.well-known/jwks.json
IAM_PUBLIC_KEY_PATH=certs/jwt_public.pem
TOTP_ISSUER=SCVRI Platform
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=2592000
MFA_SESSION_TTL_SECONDS=300
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT_URL=http://localhost:9001
S3_SUPPLIER_DOCS_BUCKET=scvri-supplier-docs-local
S3_REPORT_OUTPUT_BUCKET=scvri-report-output-local
S3_ML_ARTIFACTS_BUCKET=scvri-ml-artifacts-local
AWS_SES_FROM_ADDRESS=noreply@scvri.local
KMS_RDS_KEY_ARN=
KMS_S3_KEY_ARN=
