ENVIRONMENT=development
LOG_LEVEL=DEBUG
SERVICE_VERSION=1.0.0
SERVICE_NAME=scvri-service
SERVICE_PORT=8000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=scvri_db
DB_USER=scvri
DB_PASSWORD=scvri_dev_password
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5.0
REDIS_SOCKET_CONNECT_TIMEOUT=2.0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
