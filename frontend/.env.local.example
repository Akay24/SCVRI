# =============================================================================
# SCVRI Frontend — Environment Variables
# Copy to .env.local and fill in real values
# =============================================================================

# ----- API Gateway --------------------------------------------------------
# Base URL for all backend API calls (no trailing slash)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# WebSocket base URL for real-time alerts
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000

# ----- Mapbox (required for Supply Chain Map page) -----------------------
# Get a free token at https://account.mapbox.com/
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1IjoiWU9VUl9VU0VSTkFNRSIsImEiOiJZT1VSX1RPS0VOIn0.EXAMPLE

# ----- Feature Flags (optional, mirrors backend) -------------------------
NEXT_PUBLIC_ENABLE_AI_RISK_SCORING=true
NEXT_PUBLIC_ENABLE_REAL_TIME_TRACKING=true
NEXT_PUBLIC_ENABLE_PREDICTIVE_ANALYTICS=false

# ----- Auth / Tenant (optional overrides) --------------------------------
# NEXT_PUBLIC_AUTH_ISSUER=http://localhost:8000

# IAM service URL (server-side only)
IAM_URL=http://localhost:8000

# Set to "true" to skip the IAM service and use hardcoded demo credentials.
# NEVER enable in production.
# DEV_AUTH_BYPASS=true
