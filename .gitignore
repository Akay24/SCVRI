# =============================================================================
# SCVRI Platform — .gitignore
# =============================================================================

# ----- Environment & Secrets -----------------------------------------------
.env
.env.local
.env.*.local
*.pem
certs/
!certs/.gitkeep

# ----- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg
.venv/
venv/
env/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.cover
.hypothesis/

# ----- Node / Frontend ---------------------------------------------------------
node_modules/
frontend/node_modules/
.next/
frontend/.next/
frontend/out/
*.tsbuildinfo
frontend/.env.local
frontend/.env.*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ----- Docker ------------------------------------------------------------------
docker-compose.override.yml

# ----- Kubernetes / Helm -------------------------------------------------------
*.kubeconfig
kubeconfig

# ----- IDEs & Editors ----------------------------------------------------------
.vscode/settings.json
.vscode/launch.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ----- OS ----------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Desktop.ini

# ----- Logs & Temp -------------------------------------------------------------
*.log
logs/
tmp/
temp/

# ----- Build artifacts ---------------------------------------------------------
dist/
build/
*.whl
